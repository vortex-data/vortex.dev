# Editor defaults for files Biome does not format (Markdown, YAML, SQL, shell,
# and Python). Biome reads this file too, but biome.json's settings win.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# The license texts stay as REUSE downloaded them.
[LICENSES/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
