{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeStableNonMajor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    ":configMigration",
    "schedule:earlyMondays",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "automergeStrategy": "squash",
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "labels": ["dependencies"],
  "patch": {
    "groupName": "all patch updates"
  },
  "packageRules": [
    {
      "description": "Hold @types/node to the deployable Node major (Vercel tops out at 24). Raise in lockstep with .nvmrc and engines.node.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "groupName": "Next.js",
      "matchPackageNames": ["next", "@next/**"]
    },
    {
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "MDX content pipeline",
      "matchPackageNames": [
        "@mdx-js/**",
        "react-markdown",
        "remark-**",
        "rehype-**",
        "velite"
      ]
    },
    {
      "groupName": "Analytics",
      "matchPackageNames": ["@vercel/analytics", "next-plausible"]
    },
    {
      "groupName": "Biome",
      "matchPackageNames": ["@biomejs/**"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "addLabels": ["github-actions"]
    },
    {
      "description": "Keep bench's updates apart from the marketing site's.",
      "matchFileNames": ["bench/**", ".github/workflows/bench-*.yml"],
      "additionalBranchPrefix": "bench-",
      "commitMessageSuffix": "(bench)",
      "addLabels": ["bench"]
    },
    {
      "description": "No required check runs a deploy, so review Vercel CLI bumps for bench-deploy.yml by hand.",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["vercel"],
      "automerge": false
    }
  ]
}
