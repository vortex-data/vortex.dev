{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeStableNonMajor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    ":configMigration",
    "schedule:earlyMondays",
    "helpers:pinGitHubActionDigests"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "automergeStrategy": "squash",
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "labels": ["dependencies"],
  "patch": {
    "groupName": "all patch updates"
  },
  "packageRules": [
    {
      "description": "Renovate cannot apply minimumReleaseAge to Bun lock refreshes, so its stability check would stay pending and hold the automerge. bunfig.toml's install.minimumReleaseAge enforces the same 7-day wait while Bun regenerates the lockfile.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "Hold @types/node to the Node major that production and CI run (26). Raise in lockstep with .nvmrc and engines.node.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<27"
    },
    {
      "description": "A Node major moves .nvmrc and engines.node, which Vercel resolves for production. Approve it on the Dependency Dashboard only after Vercel offers that major, and raise @types/node's cap with it.",
      "matchDepNames": ["node"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "groupName": "Next.js",
      "matchPackageNames": ["next", "@next/**"]
    },
    {
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "MDX content pipeline",
      "matchPackageNames": ["rehype-**", "remark-**", "velite"]
    },
    {
      "groupName": "Analytics",
      "matchPackageNames": ["@vercel/analytics", "next-plausible"]
    },
    {
      "groupName": "Biome",
      "matchPackageNames": ["@biomejs/**"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "addLabels": ["github-actions"]
    },
    {
      "description": "One Bun version everywhere: package.json's packageManager and the workflows' bun-version move in one PR. This rule comes after the GitHub Actions group so that it wins.",
      "matchDepNames": ["bun"],
      "groupName": "Bun"
    },
    {
      "description": "Keep bench's updates apart from the marketing site's: the packages only bench uses, and bench's workflows.",
      "matchPackageNames": [
        "@vercel/functions",
        "chart.js",
        "chartjs-plugin-zoom",
        "pg",
        "@types/pg",
        "@testcontainers/**",
        "jsdom",
        "vite",
        "vitest"
      ],
      "additionalBranchPrefix": "bench-",
      "commitMessageSuffix": "(bench)",
      "addLabels": ["bench"]
    },
    {
      "description": "bench's workflows, in bench's branches too.",
      "matchFileNames": [".github/workflows/bench-*.yml"],
      "additionalBranchPrefix": "bench-",
      "commitMessageSuffix": "(bench)",
      "addLabels": ["bench"]
    }
  ]
}
