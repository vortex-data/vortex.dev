{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automergeStableNonMajor",
    ":automergePr",
    ":automergeRequireAllStatusChecks",
    ":combinePatchMinorReleases",
    ":dependencyDashboard",
    ":separateMultipleMajorReleases",
    ":configMigration",
    "schedule:earlyMondays",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "automergeStrategy": "squash",
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "conflicted",
  "platformAutomerge": true,
  "labels": ["dependencies"],
  "patch": {
    "groupName": "all patch updates"
  },
  "packageRules": [
    {
      "description": "Renovate cannot apply minimumReleaseAge to Bun lock refreshes, so its stability check would stay pending and hold the automerge. bunfig.toml's install.minimumReleaseAge enforces the same 7-day wait while Bun regenerates the lockfile.",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    },
    {
      "description": "Keep the postcss-selector-parser override on 6.x. @tailwindcss/typography pins 6.0.10, and the override only lifts it to a patched 6.x; typography has not moved to 7. Drop this with the override.",
      "matchPackageNames": ["postcss-selector-parser"],
      "allowedVersions": "<7"
    },
    {
      "description": "Hold @types/node to the Node major that production and CI run (26). Raise in lockstep with .nvmrc and engines.node.",
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<27"
    },
    {
      "description": "bench's functions still run on Node 24 (see CLAUDE.md, bench), so hold its @types/node to 24. Drop this when the benchmarks-website project moves to 26.x.",
      "matchFileNames": ["bench/web/package.json"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    },
    {
      "groupName": "Next.js",
      "matchPackageNames": ["next", "@next/**"]
    },
    {
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "TailwindCSS",
      "matchPackageNames": ["tailwindcss", "@tailwindcss/**"]
    },
    {
      "groupName": "MDX content pipeline",
      "matchPackageNames": [
        "@mdx-js/**",
        "react-markdown",
        "remark-**",
        "rehype-**",
        "velite"
      ]
    },
    {
      "groupName": "Analytics",
      "matchPackageNames": ["@vercel/analytics", "next-plausible"]
    },
    {
      "groupName": "Biome",
      "matchPackageNames": ["@biomejs/**"]
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "addLabels": ["github-actions"]
    },
    {
      "description": "Keep bench's updates apart from the marketing site's.",
      "matchFileNames": [
        "bench/**",
        ".github/workflows/bench-*.yml",
        ".github/vercel-cli/**"
      ],
      "additionalBranchPrefix": "bench-",
      "commitMessageSuffix": "(bench)",
      "addLabels": ["bench"]
    }
  ]
}
